//----------------------------------------------
// BCD to 7-Segment module
// --------------------------------------------
module seg_decoder(bcd, seg_data);
    input [3:0] bcd;
    output [7:0] seg_data;
    reg [7:0] seg_data;
    
    always @(bcd) begin
        case(bcd)
            4'h0 : seg_data = 8'b1111_1100; // 0
            4'h1 : seg_data = 8'b0110_0000; // 1
            4'h2 : seg_data = 8'b1101_1010; // 2
            4'h3 : seg_data = 8'b1111_0010; // 3
            4'h4 : seg_data = 8'b0110_0110; // 4
            4'h5 : seg_data = 8'b1011_0110; // 5
            4'h6 : seg_data = 8'b1011_1110; // 6
            4'h7 : seg_data = 8'b1110_0000; // 7
            4'h8 : seg_data = 8'b1111_1110; // 8
            4'h9 : seg_data = 8'b1111_0110; // 9
            4'ha : seg_data = 8'b1110_1110; // A 
            4'hb : seg_data = 8'b0011_1110; // b
            4'hc : seg_data = 8'b1001_1100; // C
            4'hd : seg_data = 8'b0111_1010; // d
            4'he : seg_data = 8'b1001_1110; // E
            4'hf : seg_data = 8'b1000_1110; // F
            default: seg_data = 8'b0000_0000; // default
        endcase
    end
endmodule

// --------------------------------------------
// Piezo module (1MHz 클럭 기준)
// 알람이 활성화되면 "솔솔라라솔솔미미솔솔미미레" 멜로디 재생 (5초정도 재생)
// --------------------------------------------
module piezo_alarm(
    input clk_1mhz,         // 1 MHz 클럭
    input rst,              
    input enable,           // 알람 활성화 신호
    output reg piezo        // Piezo 신호
);
    
    parameter DO = 12'd1912;  // C4 
    parameter RE = 12'd1703;  // D4 
    parameter MI = 12'd1517;  // E4
    parameter FA = 12'd1432;  // F4 
    parameter SOL = 12'd1275;  // G4 
    parameter LA = 12'd1136;  // A4
    parameter SI = 12'd1012;  // B4
    
    // 멜로디: 솔솔라라솔솔미미솔솔미미레(13개 음) => 학교종이 땡땡땡
    reg [3:0] note_index;     // 현재 출력중인 음표의 index
    reg [11:0] cnt;           // Piezo 카운터
    reg [11:0] cnt_limit;     // 현재 음의 주파수
    reg [18:0] note_duration; // 각 음의 재생 지속시간 카운터 (385ms)
    reg playing;              // 멜로디 재생 중인거 알기위한 위한 값
    
    // 현재 음표에 따른 주파수 설정
    always @(*) begin
        if (playing) begin
            case (note_index)
                4'd0: cnt_limit = SOL;  // 솔
                4'd1: cnt_limit = SOL;  // 솔
                4'd2: cnt_limit = LA;   // 라
                4'd3: cnt_limit = LA;   // 라
                4'd4: cnt_limit = SOL;  // 솔
                4'd5: cnt_limit = SOL;  // 솔
                4'd6: cnt_limit = MI;   // 미
                4'd7: cnt_limit = MI;   // 미
                4'd8: cnt_limit = SOL;  // 솔
                4'd9: cnt_limit = SOL;  // 솔
                4'd10: cnt_limit = MI;   // 미
                4'd11: cnt_limit = MI;   // 미
                4'd12: cnt_limit = RE;   // 레
                default: cnt_limit = 12'd0;
            endcase
        end
        else
            cnt_limit = 12'd0;
    end
    
    // 음악 재생 제어를 위한 코드
    always @(posedge clk_1mhz or posedge rst) begin
        if (rst) begin
            note_index <= 4'd0;
            note_duration <= 19'd0;
            playing <= 1'b0;
        end
        else begin
            if (enable && !playing) begin
                // 알람 시작
                playing <= 1'b1;
                note_index <= 4'd0;
                note_duration <= 19'd0;
            end
            else if (playing) begin
                if (note_duration >= 19'd385000) begin  // 385ms 이후
                    note_duration <= 19'd0;
                    if (note_index >= 4'd12) begin
                        // 멜로디 종료
                        playing <= 1'b0;
                        note_index <= 4'd0;
                    end
                    else begin
                        // 다음 음표로
                        note_index <= note_index + 4'd1;
                    end
                end
                else begin
                    note_duration <= note_duration + 19'd1;
                end
            end
            else if (!enable) begin
                // enable이 꺼지면 초기화
                playing <= 1'b0;
                note_index <= 4'd0;
                note_duration <= 19'd0;
            end
        end
    end
    
    // Piezo 음생성을 위한 코드
    always @(posedge clk_1mhz or posedge rst) begin
        if (rst) begin
            cnt <= 12'd0;
            piezo <= 1'b0;
        end
        else if (cnt_limit != 12'd0) begin
            if (cnt >= cnt_limit / 2) begin
                piezo <= ~piezo;
                cnt <= 12'd0;
            end
            else
                cnt <= cnt + 12'd1;
        end
        else begin
            cnt <= 12'd0;
            piezo <= 1'b0;
        end
    end
endmodule


// --------------------------------------------
// 모드명, 도시 이름 및 날짜를 LCD에 표시하는 Controller
// LCD 첫째 줄: 모드 상태(어떤 모드에 있는지), 도시 이름(모드에서 도시이름 설정할 때)
// LCD 둘째 줄: 오늘의 날짜 (YYYY/MM/DD가 표시되게)
// --------------------------------------------
module city_date_lcd_controller(
    input rst,
    input clk,
    input [2:0] mode,           // 현재 모드
    input [3:0] city_code,      // 도시 코드
    input [11:0] year,          // 년도
    input [4:0] month,          // 월
    input [5:0] day,            // 일

    output LCD_E,
    output reg LCD_RS,
    output reg LCD_RW,
    output reg [7:0] LCD_DATA
);

    assign LCD_E = clk;

    reg [7:0] cnt;
    reg [2:0] state;
    
    // 모드 값들 (watch 모듈에 있는 값과 똑같이 정의함)
    localparam MODE_NORMAL = 3'd0;
    localparam MODE_SET_HOUR = 3'd1;
    localparam MODE_SET_MIN = 3'd2;
    localparam MODE_SET_ZONE = 3'd3;
    localparam MODE_TIMER = 3'd4;
    localparam MODE_POMODORO = 3'd5;
    localparam MODE_POMO_SET_WORK = 3'd6;
    localparam MODE_POMO_SET_REST = 3'd7;
    
    // lCD에 표현하기 위해 날짜를 BCD로 변환할때 사용하는 값
    reg [3:0] year_thou, year_hun, year_ten, year_one;
    reg [3:0] month_ten, month_one;
    reg [3:0] day_ten, day_one;
    
    always @(*) begin //이 block 이 bin2BCD 역할을 수행
        year_thou = (year / 1000) % 10;
        year_hun = (year / 100) % 10;
        year_ten = (year / 10) % 10;
        year_one = year % 10;
        month_ten = month / 10;
        month_one = month % 10;
        day_ten = day / 10;
        day_one = day % 10;
    end

    localparam DELAY = 3'd0,
               FUNCTION_SET = 3'd1,
               DISP_ONOFF = 3'd2,
               ENTRY_MODE = 3'd3,
               SET_ADDRESS = 3'd4,
               DELAY_T = 3'd5,
               WRITE = 3'd6;

    // state machine
    always @(posedge clk or negedge rst) begin
        if (!rst) begin
            state <= DELAY;
        end else begin
            case (state)
                DELAY: if (cnt == 8'd70)  state <= FUNCTION_SET;
                FUNCTION_SET: if (cnt == 8'd30) state <= DISP_ONOFF;
                DISP_ONOFF: if (cnt == 8'd30) state <= ENTRY_MODE;
                ENTRY_MODE: if (cnt == 8'd30) state <= SET_ADDRESS;
                SET_ADDRESS: if (cnt == 8'd100) state <= DELAY_T;
                DELAY_T: state <= WRITE;
                WRITE: if (cnt == 8'd50) state <= DELAY_T;
                default: state <= DELAY;
            endcase
        end
    end

    // 카운터
    always @(posedge clk or negedge rst) begin
        if (!rst)
            cnt <= 8'd0;
        else begin
            case (state)
                DELAY: cnt <= (cnt >= 8'd70) ? 8'd0 : cnt + 8'd1;
                FUNCTION_SET: cnt <= (cnt >= 8'd30) ? 8'd0 : cnt + 8'd1;
                DISP_ONOFF: cnt <= (cnt >= 8'd30) ? 8'd0 : cnt + 8'd1;
                ENTRY_MODE: cnt <= (cnt >= 8'd30) ? 8'd0 : cnt + 8'd1;
                SET_ADDRESS: cnt <= (cnt >= 8'd100) ? 8'd0 : cnt + 8'd1;
                DELAY_T: cnt <= 8'd0;
                WRITE: cnt <= (cnt >= 8'd50) ? 8'd0 : cnt + 8'd1;
                default: cnt <= 8'd0;
            endcase
        end
    end

    // LCD control signal
    always @(posedge clk or negedge rst) begin
        if (!rst) begin
            {LCD_RS, LCD_RW, LCD_DATA} <= 10'b0_0_0000_0001;
        end else begin
            case (state)
                FUNCTION_SET: {LCD_RS, LCD_RW, LCD_DATA} <= 10'b0_0_0011_1000;
                DISP_ONOFF: {LCD_RS, LCD_RW, LCD_DATA} <= 10'b0_0_0000_1100;
                ENTRY_MODE: {LCD_RS, LCD_RW, LCD_DATA} <= 10'b0_0_0000_0110;
                SET_ADDRESS: {LCD_RS, LCD_RW, LCD_DATA} <= 10'b0_0_1000_0000;
                DELAY_T: {LCD_RS, LCD_RW, LCD_DATA} <= 10'b0_0_0000_1100;
                
                WRITE: begin
                    case (cnt)
                        // 첫째 줄: 모드 상태나 도시 이름 표시
                        8'd0: {LCD_RS, LCD_RW, LCD_DATA} <= 10'b0_0_1000_0000; // 첫째 줄 시작
                        
                        // 모드별 이름 출력
                        8'd1, 8'd2, 8'd3, 8'd4, 8'd5, 8'd6, 8'd7, 8'd8, 8'd9, 8'd10, 8'd11, 8'd12: begin
                            case (mode)
                                MODE_NORMAL: begin // CLOCK
                                    case (cnt)
                                        8'd1: {LCD_RS, LCD_RW, LCD_DATA} <= 10'b1_0_0100_0011; // C
                                        8'd2: {LCD_RS, LCD_RW, LCD_DATA} <= 10'b1_0_0100_1100; // L
                                        8'd3: {LCD_RS, LCD_RW, LCD_DATA} <= 10'b1_0_0100_1111; // O
                                        8'd4: {LCD_RS, LCD_RW, LCD_DATA} <= 10'b1_0_0100_0011; // C
                                        8'd5: {LCD_RS, LCD_RW, LCD_DATA} <= 10'b1_0_0100_1011; // K
                                        default: {LCD_RS, LCD_RW, LCD_DATA} <= 10'b1_0_0010_0000; // 공백
                                    endcase
                                end
                                
                                MODE_SET_HOUR: begin // SET HOUR
                                    case (cnt)
                                        8'd1: {LCD_RS, LCD_RW, LCD_DATA} <= 10'b1_0_0101_0011; // S
                                        8'd2: {LCD_RS, LCD_RW, LCD_DATA} <= 10'b1_0_0100_0101; // E
                                        8'd3: {LCD_RS, LCD_RW, LCD_DATA} <= 10'b1_0_0101_0100; // T
